{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sage-28kp.onrender.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://sage-web-cdep.onrender.com"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sage-28kp.onrender.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://sage-web-cdep.onrender.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sage-28kp.onrender.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://sage-web-cdep.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}