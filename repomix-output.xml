Content:
{content[:10000]}'''
                    }],
                    'response_format': {"type": "json_object"},
                    'max_tokens': 3000,
                },
                timeout=20
            )
            return json.loads(response.json()['choices'][0]['message']['content'])
        except Exception as e:
            print(f'[AI Error] {e}')
            return None


