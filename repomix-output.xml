                    <Ionicons name="arrow-undo-outline" size={15} color={COLORS.danger} />
                    <Text style={styles.rejectText}>Send back</Text>
                  </TouchableOpacity>
                </View>
              )}
            </View>
          ))}
        </ScrollView>
      </View>
    </View>
  );
}

