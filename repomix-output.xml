      style={{ width: size, height: size, borderRadius: size / 2, justifyContent: 'center', alignItems: 'center' }}
    >
      <Text style={{ color: 'white', fontFamily: FONTS.black, fontSize: size * 0.36 }}>{initials}</Text>
    </LinearGradient>
  );
}

