            <Ionicons name="log-out-outline" size={20} color={COLORS.danger} />
            <Text style={styles.logoutText}>Log Out</Text>
          </TouchableOpacity>
        </View>

        <View style={styles.footer}>
          <Text style={styles.footerText}>SAGE Learning · Educator Portal v1.0</Text>
        </View>
      </ScrollView>
    </View>
  );
}

